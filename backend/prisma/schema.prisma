// Schema Prisma: mendefinisikan struktur tabel database
// Setelah file ini diedit, jalankan `npx prisma migrate dev` untuk menerapkannya ke database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // diambil dari file .env
}

// Status lamaran kerja — pakai enum supaya nilainya terbatas & konsisten
enum Status {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

// Tipe catatan — membedakan catatan interview biasa dengan reminder follow-up
enum NoteType {
  INTERVIEW_NOTE
  REMINDER
}

model Application {
  id          Int      @id @default(autoincrement())
  company     String
  position    String
  status      Status   @default(APPLIED)
  jobUrl      String?  // tanda "?" artinya boleh kosong (optional)
  appliedDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi one-to-many: satu Application punya banyak Note
  notes       Note[]
}

model Note {
  id            Int       @id @default(autoincrement())
  content       String
  type          NoteType  @default(INTERVIEW_NOTE)
  reminderDate  DateTime? // hanya diisi kalau type = REMINDER
  createdAt     DateTime  @default(now())

  // Foreign key ke Application
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
